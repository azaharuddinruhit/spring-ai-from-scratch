---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Sidebar from '@/components/Sidebar.astro';
import Breakable from '@/components/Breakable.astro';
import { publishedSequence, withBase, type NavModule } from '@/lib/course';
import { STACK } from '@/data/versions';

interface Props {
  nav: NavModule[];
  id: string;
  title: string;
  description: string;
  headings: MarkdownHeading[];
  /** Reading time of each h2 section, in order (see src/lib/section-reading-time.mjs). */
  sectionMinutes: number[];
}

const { nav, id, title, description, headings, sectionMinutes } = Astro.props;
const module = nav.find((m) => m.navLessons.some((l) => l.id === id))!;
const sequence = publishedSequence(nav);
const index = sequence.findIndex((l) => l.id === id);
const previous = sequence[index - 1];
const next = sequence[index + 1];
const toc = headings.filter((h) => h.depth === 2);
const sections = toc.map((h, i) => ({ slug: h.slug, text: h.text, minutes: sectionMinutes[i] }));
---

<BaseLayout title={title} description={description} hasSidebar>
  <div class="mx-auto flex max-w-[90rem]">
    <aside
      aria-label="Course contents"
      class="sticky top-(--header-h) hidden h-[calc(100vh-var(--header-h))] w-72 shrink-0 overflow-y-auto overscroll-contain border-r border-slate-200 px-5 py-6 lg:block dark:border-slate-800"
    >
      <Sidebar nav={nav} currentId={id} />
    </aside>
    <script is:inline>
      // The course list is taller than a laptop screen: bring the current lesson into view before the first paint.
      {
        const aside = document.currentScript.previousElementSibling;
        const current = aside.querySelector('[aria-current="page"]').getBoundingClientRect();
        const box = aside.getBoundingClientRect();
        if (current.bottom > box.bottom) aside.scrollTop = current.top - box.top - aside.clientHeight / 3;
      }
    </script>

    <main id="content" class="min-w-0 flex-1 px-4 py-10 sm:px-8 lg:px-12">
      <article class="mx-auto max-w-3xl">
        <a
          href={withBase(`/#module-${module.number}`)}
          class="text-sm font-medium text-brand-700 hover:underline hover:underline-offset-4 dark:text-brand-400"
        >
          Module {module.number}: {module.title}
        </a>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900 sm:text-[2.5rem] sm:leading-[1.1] dark:text-white"><Breakable text={title} /></h1>
        <p class="mt-4 text-lg leading-relaxed text-slate-600 dark:text-slate-400">{description}</p>
        <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">
          Written for Java {STACK.java}, Spring Boot {STACK.springBoot}, Spring AI {STACK.springAi} and Gradle {STACK.gradle}.
        </p>

        <div class="lesson-prose mt-6">
          <slot />
        </div>

        <nav class="mt-16 grid gap-4 border-t border-slate-200 pt-8 sm:grid-cols-2 dark:border-slate-800" aria-label="Lesson">
          {
            previous && (
              <a
                href={previous.href}
                class="group rounded-lg border border-slate-200 p-4 hover:border-brand-500 dark:border-slate-800 dark:hover:border-brand-500"
              >
                <span class="text-sm text-slate-500 dark:text-slate-400">Previous lesson</span>
                <span class="mt-1 block font-medium text-slate-900 group-hover:text-brand-700 dark:text-white dark:group-hover:text-brand-400">
                  <Breakable text={previous.title} />
                </span>
              </a>
            )
          }
          {
            next && (
              <a
                href={next.href}
                class="group rounded-lg border border-slate-200 p-4 text-right hover:border-brand-500 sm:col-start-2 dark:border-slate-800 dark:hover:border-brand-500"
              >
                <span class="text-sm text-slate-500 dark:text-slate-400">Next lesson</span>
                <span class="mt-1 block font-medium text-slate-900 group-hover:text-brand-700 dark:text-white dark:group-hover:text-brand-400">
                  <Breakable text={next.title} />
                </span>
              </a>
            )
          }
        </nav>
      </article>
    </main>

    <aside class="sticky top-(--header-h) hidden h-[calc(100vh-var(--header-h))] w-60 shrink-0 overflow-y-auto py-10 pr-6 xl:block">
      <p class="mb-3 text-sm font-semibold text-slate-900 dark:text-white">On this page</p>
      <ul class="space-y-2 text-sm">
        {
          sections.map((section) => (
            <li>
              <a
                href={`#${section.slug}`}
                class="flex items-baseline justify-between gap-3 text-slate-600 hover:text-brand-700 dark:text-slate-400 dark:hover:text-brand-400"
              >
                {section.text}
                <span class="shrink-0 text-xs text-slate-500 tabular-nums dark:text-slate-400">{section.minutes} min</span>
              </a>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>

  <dialog
    id="course-sheet"
    data-course-sheet
    aria-labelledby="course-sheet-title"
    class="course-sheet border-t border-slate-200 bg-white text-slate-900 lg:hidden dark:border-slate-800 dark:bg-slate-900 dark:text-white"
  >
    <div data-sheet-grip class="shrink-0 touch-none px-5 pt-2">
      <div class="mx-auto h-1 w-9 rounded-full bg-slate-300 dark:bg-slate-600" aria-hidden="true"></div>
      <div class="mt-1 flex items-center justify-between gap-3">
        <h2 id="course-sheet-title" class="text-sm font-semibold">Course contents</h2>
        <form method="dialog">
          <button
            class="-mr-2 rounded-md p-2 text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white"
            aria-label="Close course navigation"
          >
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"></path>
            </svg>
          </button>
        </form>
      </div>
    </div>
    <div class="min-h-0 overflow-y-auto overscroll-contain px-5 pt-1 pb-[max(1.5rem,env(safe-area-inset-bottom))]">
      <Sidebar nav={nav} currentId={id} sections={sections} />
    </div>
  </dialog>
</BaseLayout>

<script>
  // Below lg the course menu is a bottom sheet on a modal <dialog>: the browser traps focus, closes it on Escape, makes the
  // page inert and gives focus back to the menu button. This adds the rest: closing on the backdrop, after a section link,
  // when the window grows to lg, and when the sheet is dragged down by its top bar.
  const sheet = document.querySelector<HTMLDialogElement>('[data-course-sheet]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-course-menu]');
  const grip = sheet?.querySelector<HTMLElement>('[data-sheet-grip]');

  if (sheet && toggle && grip) {
    // Focus never scrolls the page here (Chrome moved it by half a screen); only the list scrolls, to the current lesson.
    const list = grip.nextElementSibling as HTMLElement;
    toggle.addEventListener('click', () => {
      toggle.focus({ preventScroll: true }); // a tap doesn't focus a button everywhere, and the dialog gives focus back to it
      sheet.showModal();
      toggle.setAttribute('aria-expanded', 'true');
      const current = list.querySelector<HTMLElement>('[aria-current="page"]');
      if (!current) return;
      current.focus({ preventScroll: true });
      list.scrollTop += current.getBoundingClientRect().top - list.getBoundingClientRect().top - 8;
    });
    sheet.addEventListener('close', () => toggle.setAttribute('aria-expanded', 'false'));

    sheet.addEventListener('click', (event) => {
      const onBackdrop = event.target === sheet && event.clientY < sheet.getBoundingClientRect().top;
      if (onBackdrop || (event.target as Element).closest('a[href^="#"]')) sheet.close();
    });
    matchMedia('(min-width: 64rem)').addEventListener('change', (query) => query.matches && sheet.close());

    let dragStart: number | null = null;
    const endDrag = (close: boolean) => {
      dragStart = null;
      sheet.style.transition = '';
      sheet.style.transform = '';
      if (close) sheet.close();
    };
    grip.addEventListener('pointerdown', (event) => {
      if ((event.target as Element).closest('button')) return;
      dragStart = event.clientY;
      grip.setPointerCapture(event.pointerId);
      sheet.style.transition = 'none';
    });
    grip.addEventListener('pointermove', (event) => {
      if (dragStart !== null) sheet.style.transform = `translateY(${Math.max(0, event.clientY - dragStart)}px)`;
    });
    grip.addEventListener('pointerup', (event) => {
      if (dragStart !== null) endDrag(event.clientY - dragStart > Math.min(120, sheet.offsetHeight / 4));
    });
    grip.addEventListener('pointercancel', () => {
      if (dragStart !== null) endDrag(false);
    });
  }
</script>
