---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Sidebar from '@/components/Sidebar.astro';
import { publishedSequence, withBase, type NavModule } from '@/lib/course';
import { STACK } from '@/data/versions';

interface Props {
  nav: NavModule[];
  id: string;
  title: string;
  description: string;
  headings: MarkdownHeading[];
}

const { nav, id, title, description, headings } = Astro.props;
const module = nav.find((m) => m.navLessons.some((l) => l.id === id))!;
const sequence = publishedSequence(nav);
const index = sequence.findIndex((l) => l.id === id);
const previous = sequence[index - 1];
const next = sequence[index + 1];
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout title={title} description={description} hasSidebar>
  <div class="mx-auto flex max-w-[90rem]">
    <div data-sidebar-backdrop class="fixed inset-0 z-40 hidden bg-slate-950/50 lg:hidden"></div>
    <aside
      id="course-sidebar"
      data-sidebar
      aria-label="Course contents"
      class="max-lg:invisible fixed inset-y-0 left-0 z-50 w-72 -translate-x-full overflow-y-auto border-r border-slate-200 bg-white px-5 py-6 transition-[transform,visibility] lg:sticky lg:top-(--header-h) lg:z-auto lg:h-[calc(100vh-var(--header-h))] lg:translate-x-0 lg:bg-transparent dark:border-slate-800 dark:bg-slate-900 lg:dark:bg-transparent"
    >
      <Sidebar nav={nav} currentId={id} />
    </aside>

    <main id="content" class="min-w-0 flex-1 px-4 py-10 sm:px-8 lg:px-12">
      <article class="mx-auto max-w-3xl">
        <a
          href={withBase(`/#module-${module.number}`)}
          class="text-sm font-medium text-brand-700 hover:underline hover:underline-offset-4 dark:text-brand-400"
        >
          Module {module.number}: {module.title}
        </a>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900 sm:text-[2.5rem] sm:leading-[1.1] dark:text-white">{title}</h1>
        <p class="mt-4 text-lg leading-relaxed text-slate-600 dark:text-slate-400">{description}</p>
        <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">
          Written for Java {STACK.java}, Spring Boot {STACK.springBoot}, Spring AI {STACK.springAi} and Gradle {STACK.gradle}.
        </p>

        <div class="lesson-prose mt-6">
          <slot />
        </div>

        <nav class="mt-16 grid gap-4 border-t border-slate-200 pt-8 sm:grid-cols-2 dark:border-slate-800" aria-label="Lesson">
          {
            previous && (
              <a
                href={previous.href}
                class="group rounded-lg border border-slate-200 p-4 hover:border-brand-500 dark:border-slate-800 dark:hover:border-brand-500"
              >
                <span class="text-sm text-slate-500 dark:text-slate-400">Previous lesson</span>
                <span class="mt-1 block font-medium text-slate-900 group-hover:text-brand-700 dark:text-white dark:group-hover:text-brand-400">
                  {previous.title}
                </span>
              </a>
            )
          }
          {
            next && (
              <a
                href={next.href}
                class="group rounded-lg border border-slate-200 p-4 text-right hover:border-brand-500 sm:col-start-2 dark:border-slate-800 dark:hover:border-brand-500"
              >
                <span class="text-sm text-slate-500 dark:text-slate-400">Next lesson</span>
                <span class="mt-1 block font-medium text-slate-900 group-hover:text-brand-700 dark:text-white dark:group-hover:text-brand-400">
                  {next.title}
                </span>
              </a>
            )
          }
        </nav>
      </article>
    </main>

    <aside class="sticky top-(--header-h) hidden h-[calc(100vh-var(--header-h))] w-60 shrink-0 overflow-y-auto py-10 pr-6 xl:block">
      <p class="mb-3 text-sm font-semibold text-slate-900 dark:text-white">On this page</p>
      <ul class="space-y-2 text-sm">
        {
          toc.map((heading) => (
            <li>
              <a href={`#${heading.slug}`} class="text-slate-600 hover:text-brand-700 dark:text-slate-400 dark:hover:text-brand-400">
                {heading.text}
              </a>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</BaseLayout>

<script>
  // Below lg the sidebar is a drawer. While closed it is invisible, so keyboard focus can't land on links offscreen.
  const sidebar = document.querySelector<HTMLElement>('[data-sidebar]');
  const backdrop = document.querySelector<HTMLElement>('[data-sidebar-backdrop]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-sidebar-toggle]');

  const setOpen = (open: boolean) => {
    sidebar?.classList.toggle('-translate-x-full', !open);
    sidebar?.classList.toggle('max-lg:invisible', !open);
    backdrop?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    if (open) sidebar?.querySelector<HTMLElement>('[aria-current="page"], a')?.focus();
    else toggle?.focus();
  };

  toggle?.addEventListener('click', () => setOpen(true));
  backdrop?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') setOpen(false);
  });
</script>
