---
import type { NavModule } from '@/lib/course';
import Breakable from '@/components/Breakable.astro';

interface Section {
  slug: string;
  text: string;
  minutes: number;
}

interface Props {
  nav: NavModule[];
  currentId: string;
  /**
   * Given on the phone sheet: modules collapse (only the current one starts open), rows are taller for touch, and the
   * current lesson lists these sections under it.
   */
  sections?: Section[];
}

const { nav, currentId, sections } = Astro.props;
const compact = sections !== undefined;
const Module = compact ? 'details' : 'div';
const ModuleTitle = compact ? 'summary' : 'p';
const row = compact ? 'py-2' : 'py-1';
---

<nav aria-label="Course" class:list={['text-sm', compact ? 'space-y-1' : 'space-y-6']}>
  {
    nav.map((module) => (
      <Module class="group" open={compact && module.navLessons.some((l) => l.id === currentId)}>
        <ModuleTitle
          class:list={[
            'flex items-baseline gap-2 font-semibold text-slate-900 dark:text-white',
            compact ? 'cursor-pointer list-none rounded-md py-2 [&::-webkit-details-marker]:hidden' : 'mb-2',
          ]}
        >
          <span class="w-4 shrink-0 text-brand-700 tabular-nums dark:text-brand-400">{module.number}</span>
          <span class="min-w-0 flex-1">{module.title}</span>
          {compact && (
            <svg
              class="size-4 shrink-0 self-center text-slate-400 transition-transform group-open:rotate-180 motion-reduce:transition-none dark:text-slate-500"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          )}
        </ModuleTitle>
        <ul class:list={['border-l border-slate-200 dark:border-slate-800', compact ? 'mb-2' : 'space-y-0.5']}>
          {module.navLessons.map((lesson) =>
            lesson.href ? (
              <li>
                <a
                  href={lesson.href}
                  aria-current={lesson.id === currentId ? 'page' : undefined}
                  class:list={[
                    '-ml-px block border-l pr-2 pl-3 transition-colors',
                    row,
                    lesson.id === currentId
                      ? 'border-brand-600 font-medium text-brand-700 dark:border-brand-400 dark:text-brand-300'
                      : 'border-transparent text-slate-600 hover:border-slate-400 hover:text-slate-900 dark:text-slate-400 dark:hover:border-slate-500 dark:hover:text-white',
                  ]}
                >
                  <Breakable text={lesson.title} />
                </a>
                {lesson.id === currentId && sections && sections.length > 0 && (
                  <ol aria-label="On this page" class="-ml-px border-l border-brand-600 pb-1 dark:border-brand-400">
                    {sections.map((section) => (
                      <li>
                        <a
                          href={`#${section.slug}`}
                          class="flex items-baseline justify-between gap-3 py-1.5 pr-2 pl-6 text-slate-600 hover:text-brand-700 dark:text-slate-400 dark:hover:text-brand-400"
                        >
                          {section.text}
                          <span class="shrink-0 text-xs text-slate-500 tabular-nums dark:text-slate-400">{section.minutes} min</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                )}
              </li>
            ) : (
              <li
                class:list={[
                  '-ml-px flex items-center justify-between gap-2 border-l border-transparent pr-2 pl-3 text-slate-400 dark:text-slate-500',
                  row,
                ]}
              >
                <span>
                  {lesson.title}
                </span>
                <span class="shrink-0 text-xs italic">soon</span>
              </li>
            ),
          )}
        </ul>
      </Module>
    ))
  }
</nav>
