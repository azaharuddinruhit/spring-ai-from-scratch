---
import { PREVIEW_STACK } from '@/data/versions';

/**
 * Marks a preview lesson (one that teaches a Spring AI release candidate) wherever lessons are listed. It has the version
 * pill's outline in a smaller size, so it reads as a version label rather than a badge.
 */
---

<span
  class="ml-1.5 inline-block rounded-full border border-slate-300 px-1.5 align-[0.1em] text-[0.6875rem] leading-4 font-medium whitespace-nowrap text-slate-600 dark:border-slate-600 dark:text-slate-300"
  title={`Preview: Spring AI ${PREVIEW_STACK.springAi}`}>{PREVIEW_STACK.springAi.split('.').slice(0, 2).join('.')} preview</span
>
