---
/** The small muted mark after a deep-dive lesson's title in the sidebar and the course list (`deepDive` in curriculum.ts). */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['shrink-0 text-xs font-normal text-slate-500 dark:text-slate-400', className]}>Deep dive</span>
