---
import Breakable from '@/components/Breakable.astro';
interface Props {
  title: string;
  kind: 'reliability' | 'security' | 'cost' | 'migration';
}

const { title, kind } = Astro.props;

const styles = {
  reliability: { label: 'Reliability', badge: 'bg-amber-100 text-amber-800 dark:bg-amber-500/15 dark:text-amber-300', bar: 'border-l-amber-500' },
  security: { label: 'Security', badge: 'bg-rose-100 text-rose-800 dark:bg-rose-500/15 dark:text-rose-300', bar: 'border-l-rose-500' },
  cost: { label: 'Cost', badge: 'bg-sky-100 text-sky-800 dark:bg-sky-500/15 dark:text-sky-300', bar: 'border-l-sky-500' },
  migration: { label: '1.x → 2.0', badge: 'bg-violet-100 text-violet-800 dark:bg-violet-500/15 dark:text-violet-300', bar: 'border-l-violet-500' },
}[kind];
---

<section data-gotcha class:list={['my-5 rounded-lg border border-l-4 border-slate-200 bg-white p-4 shadow-xs dark:border-slate-700/70 dark:bg-slate-800/40', styles.bar]}>
  <div class="not-prose flex flex-wrap items-center gap-2">
    <span class:list={['rounded px-1.5 py-0.5 text-xs font-medium', styles.badge]}>{styles.label}</span>
    <h3 class="text-base font-semibold text-slate-900 dark:text-white"><Breakable text={title} /></h3>
  </div>
  <div class="mt-2 [&>*:first-child]:mt-0 [&>*:last-child]:mb-0">
    <slot />
  </div>
</section>
