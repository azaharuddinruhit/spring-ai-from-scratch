---
import { getCollection, render } from 'astro:content';
import LessonLayout from '@/layouts/LessonLayout.astro';
import { getNavigation } from '@/lib/course';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const nav = await getNavigation();
const lesson = nav.flatMap((m) => m.navLessons).find((l) => l.id === entry.id);
if (!lesson) {
  throw new Error(`Lesson "${entry.id}" has an MDX file but no entry in src/data/curriculum.ts`);
}
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
---

<LessonLayout nav={nav} id={entry.id} title={lesson.title} description={entry.data.description} headings={headings}
  sectionMinutes={remarkPluginFrontmatter.sectionMinutes}>
  <Content />
</LessonLayout>
